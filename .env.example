# Computer Store KS - Environment Variables
# Copy this file to .env and fill in the values

# ===========================================
# Application
# ===========================================

NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ===========================================
# GitHub Integration (Required for Gallery Manager)
# ===========================================

# Personal Access Token with repo permissions
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# GitHub repository owner (username or organization)
GITHUB_OWNER=MatthewMcManness

# Repository name
GITHUB_REPO=Computer_Store_KS

# Branch to commit changes to
GITHUB_BRANCH=version-3.0

# ===========================================
# Admin Authentication (Required)
# ===========================================

# Password for admin gallery management
# IMPORTANT: Change this to a strong password in production!
ADMIN_PASSWORD=your_secure_admin_password_here

# NextAuth.js Secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ===========================================
# Session Security (Required for RepairShopr Auth)
# ===========================================

# Session encryption secret - MUST be exactly 32 characters/bytes
# Used for AES-256-GCM encryption of server-side sessions
# Generate with: openssl rand -hex 16 | head -c 32
# Or use: node -e "console.log(require('crypto').randomBytes(32).toString('hex').slice(0,32))"
SESSION_SECRET=

# ===========================================
# RepairShopr Integration
# ===========================================

# RepairShopr subdomain (e.g., 'thecomputerstore' for thecomputerstore.repairshopr.com)
# Required for authentication and customer management
REPAIRSHOPR_SUBDOMAIN=thecomputerstore

# ===========================================
# Database (if using)
# ===========================================

DATABASE_URL=

# ===========================================
# Email Service - Resend (Required for Contact Form)
# ===========================================

# Resend API Key
# Create at: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Email address to receive contact form notifications
# Defaults to: contact@computerstoreks.com
NOTIFICATION_EMAIL=contact@computerstoreks.com

# ===========================================
# Legacy SMTP (Deprecated - Use Resend instead)
# ===========================================

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=contact@computerstoreks.com

# ===========================================
# Analytics (Optional)
# ===========================================

NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# ===========================================
# External APIs
# ===========================================

GOOGLE_MAPS_API_KEY=

# Image Storage (if using external)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===========================================
# Feature Flags
# ===========================================

NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_MAINTENANCE_MODE=false
