# Computer Store KS - Environment Variables
# Copy this file to .env and fill in the values.
# This is the final Dokploy self-hosted env set (post Supabase/Resend removal).

# ===========================================
# Database - self-hosted Postgres (Required)
# ===========================================

# Connection string for the Postgres service.
# In Dokploy this points at the in-network csks-postgres service DSN.
# Local dev example: postgres://postgres:devpw@127.0.0.1:5544/csks
DATABASE_URL=

# ===========================================
# Image Storage - local uploads volume (Required)
# ===========================================

# Directory where uploaded gallery/slideshow images are written and served from.
# Mounted as a persistent Dokploy volume. The Docker image defaults this to /data/uploads.
UPLOADS_DIR=/data/uploads

# ===========================================
# Site URL
# ===========================================

# Public site URL (used for OAuth redirects and canonical links)
NEXT_PUBLIC_SITE_URL=https://computerstoreks.com

# ===========================================
# Contact Form - n8n Contact Webhook (Required for Contact Form)
# ===========================================

# n8n webhook URL for outbound contact emails.
# The workflow validates the secret and sends via Google Workspace (no-reply@computerstoreks.com).
CSKS_CONTACT_WEBHOOK_URL=https://n8n.resilientwebsolutions.com/webhook/csks-contact

# Shared secret that the n8n workflow checks to reject unauthorized POSTs.
# Set this to a long random string and configure the same value in n8n.
CSKS_CONTACT_WEBHOOK_SECRET=

# Email address to receive contact form notifications (store inbox)
NOTIFICATION_EMAIL=contact@computerstoreks.com

# ===========================================
# GitHub CMS
# ===========================================
# Used by the GitHub-backed content workflow.
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=
GITHUB_TOKEN=

# ===========================================
# Google Business Profile (server-side only - do NOT prefix with NEXT_PUBLIC_)
# ===========================================
#
# OAuth 2.0 credentials for the shop's Google Business Profile.
# Setup instructions: docs/google-reviews-playbook.md section 2.
# - Create the credentials at https://console.cloud.google.com/apis/credentials
# - Application type: Web application
# - Authorized redirect URI must match GOOGLE_OAUTH_REDIRECT_URI below
# - Required scope: https://www.googleapis.com/auth/business.manage
#
# The refresh token itself is NOT stored here - it is written to the
# oauth_tokens table by the /api/google-business/oauth/callback route
# after an admin runs the one-time connect flow.

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Full callback URL. Must exactly match an Authorized redirect URI on
# the OAuth Client. Use http://localhost:3000/... in dev,
# https://computerstoreks.com/... in production.
GOOGLE_OAUTH_REDIRECT_URI=https://computerstoreks.com/api/google-business/oauth/callback

# ===========================================
# Bot Protection - Cloudflare Turnstile
# ===========================================

# Turnstile Site Key (public, used in frontend)
# Get from: https://dash.cloudflare.com/?to=/:account/turnstile
# Test key for development: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Turnstile Secret Key (private, used in API)
# Test key for development: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# ===========================================
# Cloudflare Access (admin auth) - set in Phase 8 at cutover
# ===========================================

# Your Cloudflare Access team domain, e.g. resilientwebsolutions.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=

# The Application Audience (AUD) tag of the protect Access app.
CF_ACCESS_AUD=

# ===========================================
# Runtime (baked into the Docker image; set here for non-container runs)
# ===========================================

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
