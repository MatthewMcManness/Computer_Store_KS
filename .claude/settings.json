{
  "hooks": {
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "paplay /usr/share/sounds/freedesktop/stereo/complete.oga"
      }]
    }],
    "Notification": [{
      "hooks": [{
        "type": "command",
        "command": "paplay /usr/share/sounds/freedesktop/stereo/bell.oga"
      }]
    }],
    "SubagentStart": [{
      "hooks": [{
        "type": "command",
        "command": "paplay /usr/share/sounds/freedesktop/stereo/service-login.oga"
      }]
    }],
    "SubagentStop": [{
      "hooks": [{
        "type": "command",
        "command": "paplay /usr/share/sounds/freedesktop/stereo/service-logout.oga"
      }]
    }]
  }
}
