# Computer Store KS - Environment Variables
# Copy this file to .env and fill in the values

# ===========================================
# Application
# ===========================================

NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ===========================================
# GitHub Integration (Required for Gallery Manager)
# ===========================================

# Personal Access Token with repo permissions
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# GitHub repository owner (username or organization)
GITHUB_OWNER=MatthewMcManness

# Repository name
GITHUB_REPO=Computer_Store_KS

# Branch to commit changes to
GITHUB_BRANCH=version-3.0

# ===========================================
# Authentication Mode
# ===========================================

# Authentication mode: 'repairshopr' (default) or 'legacy'
# - repairshopr: Uses RepairShopr API for authentication (recommended)
# - legacy: Uses simple password-based authentication
AUTH_MODE=repairshopr

# ===========================================
# Admin Authentication (Legacy Mode)
# ===========================================

# Password for admin gallery management (used in legacy mode)
# Also used as fallback if LEGACY_ADMIN_PASSWORD is not set
# IMPORTANT: Change this to a strong password in production!
ADMIN_PASSWORD=your_secure_admin_password_here

# Legacy admin password for dual-mode migration
# Used when AUTH_MODE=legacy or as API bearer token fallback
LEGACY_ADMIN_PASSWORD=

# NextAuth.js Secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ===========================================
# Session Security (Required for RepairShopr Auth)
# ===========================================

# Session encryption secret for AES-256-GCM encryption
# MUST be exactly 64 hex characters (32 bytes as hex)
# Generate with: openssl rand -hex 32
# Or use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ===========================================
# RepairShopr Integration
# ===========================================

# RepairShopr subdomain (e.g., 'thecomputerstore' for thecomputerstore.repairshopr.com)
# Required for authentication and customer management
REPAIRSHOPR_SUBDOMAIN=thecomputerstore

# RepairShopr API Key (for admin operations like user migration)
# Get from: RepairShopr Admin > More > API Keys
# Required for: scripts/migrate-users.ts
REPAIRSHOPR_API_KEY=

# ===========================================
# Database (if using)
# ===========================================

DATABASE_URL=

# ===========================================
# Email Service - Resend (Required for Contact Form)
# ===========================================

# Resend API Key
# Create at: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Email address to receive contact form notifications
# Defaults to: contact@computerstoreks.com
NOTIFICATION_EMAIL=contact@computerstoreks.com

# ===========================================
# Legacy SMTP (Deprecated - Use Resend instead)
# ===========================================

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=contact@computerstoreks.com

# ===========================================
# Analytics (Optional)
# ===========================================

NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# ===========================================
# External APIs
# ===========================================

GOOGLE_MAPS_API_KEY=

# ===========================================
# Google Business Profile API
# ===========================================
# Required for pulling reviews, posts, and business info from Google
# See setup guide: https://developers.google.com/my-business/content/prereqs

# OAuth 2.0 credentials from Google Cloud Console
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=

# Refresh token obtained after OAuth consent flow
# Generate using the OAuth playground or a one-time script
GOOGLE_BUSINESS_REFRESH_TOKEN=

# Your Google Business Profile account ID
# Find at: https://business.google.com/ (in URL after /dashboard/)
GOOGLE_BUSINESS_ACCOUNT_ID=

# Your location ID (for multi-location businesses)
# Find via API or in Business Profile settings
GOOGLE_BUSINESS_LOCATION_ID=

# Image Storage (if using external)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===========================================
# Supabase (Database & Authentication)
# ===========================================
# Project ID: gzcmwpcxnwlgknhjijic
# Dashboard: https://supabase.com/dashboard/project/gzcmwpcxnwlgknhjijic

# Supabase project URL
# Find at: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://gzcmwpcxnwlgknhjijic.supabase.co

# Supabase anon/public key (safe for client-side)
# Find at: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase service role key (server-side only, keep secret!)
# Find at: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ===========================================
# Supabase Auth SMTP Configuration (Resend)
# ===========================================
# These settings are configured in Supabase Dashboard, not as env vars.
# Documentation: docs/supabase/auth-configuration.md
#
# SMTP Settings (configure in Supabase Dashboard > Settings > Auth > SMTP):
# - Host: smtp.resend.com
# - Port: 465 (SSL)
# - Username: resend
# - Password: Use RESEND_API_KEY value
# - Sender Email: noreply@computerstoreks.com
# - Sender Name: Computer Store KS
#
# Session Settings (configure in Supabase Dashboard):
# - JWT Expiry: 3600 seconds (1 hour)
# - Refresh Token Rotation: Enabled
#
# Rate Limits (configure in Supabase Dashboard):
# - Sign up/in: 5 requests per 15 minutes
# - Password recovery: 5 requests per 15 minutes
#
# Email Templates: See docs/supabase/email-templates/

# ===========================================
# Bot Protection - Cloudflare Turnstile
# ===========================================

# Turnstile Site Key (public, used in frontend)
# Get from: https://dash.cloudflare.com/?to=/:account/turnstile
# Test key for development: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Turnstile Secret Key (private, used in API)
# Get from: https://dash.cloudflare.com/?to=/:account/turnstile
# Test key for development: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# ===========================================
# NinjaOne RMM Integration
# ===========================================
# Required for remote monitoring and management features
# API Documentation: https://app.ninjarmm.com/apidocs/

# NinjaOne API URL (region-specific)
# US: https://app.ninjarmm.com
# EU: https://eu.ninjarmm.com
# OC (Oceania): https://oc.ninjarmm.com
NINJAONE_API_URL=https://app.ninjarmm.com

# OAuth2 Client ID
# Create at: NinjaOne Admin > Administration > Apps > API
NINJAONE_CLIENT_ID=

# OAuth2 Client Secret
# Create at: NinjaOne Admin > Administration > Apps > API
NINJAONE_CLIENT_SECRET=

# ===========================================
# Cytracom Phone System Integration
# ===========================================
# Required for phone system integration features
# API Documentation: https://help.cytracom.com/hc/en-us/sections/360003366471-Cytracom-s-Public-API

# Cytracom API Token
# Create at: Cytracom Portal (secure.cytracom.net) > Settings > Tokens
CYTRACOM_API_TOKEN=

# Cytracom API Base URL (usually doesn't need to change)
CYTRACOM_API_URL=https://api.cytracom.net/v1.0

# Employee Extensions (comma-separated: extension:name)
# Example: 106:Manager,107:Reception,108:Tech
CYTRACOM_EXTENSIONS=106:Manager,107:Reception,108:Tech

# ===========================================
# Feature Flags
# ===========================================

NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_MAINTENANCE_MODE=false
