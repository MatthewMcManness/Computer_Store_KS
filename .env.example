# Computer Store KS - Environment Variables
# Copy this file to .env and fill in the values

# ===========================================
# Supabase (Database & Authentication)
# ===========================================

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/public key (safe for client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase service role key (server-side only, keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ===========================================
# Email Service - Resend (Required for Contact Form)
# ===========================================

# Resend API Key - Create at: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Email address to receive contact form notifications
NOTIFICATION_EMAIL=contact@computerstoreks.com

# ===========================================
# Site URL
# ===========================================

# Public site URL (used for OAuth redirects and canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===========================================
# Bot Protection - Cloudflare Turnstile
# ===========================================

# Turnstile Site Key (public, used in frontend)
# Get from: https://dash.cloudflare.com/?to=/:account/turnstile
# Test key for development: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Turnstile Secret Key (private, used in API)
# Test key for development: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# ===========================================
# Google Business Profile (server-side only — do NOT prefix with NEXT_PUBLIC_)
# ===========================================
#
# OAuth 2.0 credentials for the shop's Google Business Profile.
# Setup instructions: docs/google-reviews-playbook.md §2.
# - Create the credentials at https://console.cloud.google.com/apis/credentials
# - Application type: Web application
# - Authorized redirect URI must match GOOGLE_OAUTH_REDIRECT_URI below
# - Required scope: https://www.googleapis.com/auth/business.manage
#
# The refresh token itself is NOT stored here — it is written to the
# Supabase `oauth_tokens` table by the /api/google-business/oauth/callback
# route after an admin runs the one-time connect flow.

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Full callback URL. Must exactly match an Authorized redirect URI on
# the OAuth Client. Use http://localhost:3000/... in dev,
# https://computerstoreks.com/... in production.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google-business/oauth/callback
